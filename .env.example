# Copy to .env and fill in. Never commit .env.
# Generate secrets with:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"

# ---------- Public URL of the web service (no trailing slash) ----------
# Production: https only. The OIDC redirect URI is PUBLIC_BASE_URL + /callback.
PUBLIC_BASE_URL=http://localhost:3000
WEB_PORT=3000
# Optional: invite link shown on the landing page
PUBLIC_DISCORD_INVITE=

# ---------- Authentication provider ----------
# "email" = one-time code sent to the institutional mailbox (no registration needed)
# "uowm"  = the real UoWM SSO (only after the service is registered with UoWM IT)
# "mock"  = local mock OIDC server (docker compose --profile mock up)
AUTH_PROVIDER=email
# email and uowm require https PUBLIC_BASE_URL; set true only for local development over http
ALLOW_INSECURE_DEV=true

# ---------- Email code provider ----------
# "smtp" in production. "console" prints codes to the web log (local development only).
EMAIL_TRANSPORT=console
EMAIL_FROM="Πληροφορική UoWM Discord <your-sender@example.com>"
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# Institutional mail domain and the student username pattern (first group = student number)
EMAIL_DOMAIN=uowm.gr
EMAIL_STUDENT_PATTERN='^cs(\d{4,6})$'
# Faculty addresses are read from data/faculty-emails.txt (see data/faculty-emails.example.txt)

# ---------- OIDC providers (uowm, mock) ----------

# Issued by the UoWM NOC on registration (for mock: any values, shared with the mock server)
OIDC_CLIENT_ID=discord-verify-dev
OIDC_CLIENT_SECRET=change-me-dev-secret

# Real provider only. Defaults to https://sso.uowm.gr/oidc
OIDC_ISSUER=
# Scopes. Default "openid extendedProfile". Confirm with the NOC which scope releases eduPersonAffiliation.
OIDC_SCOPES=
# Set to false if all needed claims are in the ID token. Default true.
OIDC_FETCH_USERINFO=

# Mock provider only. Browser-facing issuer, and the address the web container uses to reach it.
MOCK_ISSUER=http://localhost:4000
MOCK_INTERNAL_ORIGIN=http://mock-idp:4000

# ---------- Hashing (all providers) ----------
# Keyed hash for university identifiers and email codes. At least 32 characters. Changing it breaks the
# "one university account per Discord account" check for existing rows.
UNI_ID_HASH_SECRET=replace-with-a-long-random-secret-at-least-32-chars

# ---------- Eligibility policy (OIDC providers) ----------
# Accounts must belong to this home organization (eduPersonScopedAffiliation / schacHomeOrganization).
# "off" only if the provider releases neither claim.
EXPECTED_HOME_ORG=uowm.gr
# Only students of the Department of Informatics get the student role.
# The claim name and value format must be confirmed with the UoWM NOC; the values below match the MOCK users only.
STUDENT_DEPARTMENT_FILTER=on
STUDENT_DEPARTMENT_CLAIM=schGrAcEnrollment
STUDENT_DEPARTMENT_PATTERN=':department:informatics$'

# ---------- Discord ----------
DISCORD_TOKEN=
GUILD_ID=
ADMIN_ROLE_ID=
MODERATOR_ROLE_ID=
# Φοιτητής
STUDENT_ROLE_ID=
# Καθηγητής (faculty and staff)
PROFESSOR_ROLE_ID=
GUEST_ROLE_ID=
# Private log channel for admins/moderators
ADMIN_CHANNEL_ID=
# Private log channel for guest role grants
GUEST_CHANNEL_ID=
# Comma-separated IDs of the Dyno semester roles (Α to Η Εξάμηνο)
SEMESTER_ROLE_IDS=
# Roles allowed to hold semester roles. Default: STUDENT_ROLE_ID only.
# To let guests pick semesters too: <STUDENT_ROLE_ID>,<GUEST_ROLE_ID>
SEMESTER_ALLOWED_ROLE_IDS=

# ---------- MariaDB ----------
DB_USER=uowm_bot
DB_PASSWORD=replace-with-a-strong-password
DB_NAME=uowm_bot
