# Copy to .env and fill in. Never commit .env.
# Generate secrets with:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"

# ---------- Discord ----------
DISCORD_TOKEN=
GUILD_ID=
ADMIN_ROLE_ID=
MODERATOR_ROLE_ID=
# Φοιτητής
STUDENT_ROLE_ID=
# Καθηγητής
PROFESSOR_ROLE_ID=
GUEST_ROLE_ID=
# Private log channel for admins/moderators
ADMIN_CHANNEL_ID=
# Private log channel for guest role grants
GUEST_CHANNEL_ID=
# Comma-separated IDs of the Dyno semester roles (Α to Η Εξάμηνο)
SEMESTER_ROLE_IDS=
# Roles allowed to hold semester roles. Default: STUDENT_ROLE_ID only.
# To let guests pick semesters too: <STUDENT_ROLE_ID>,<GUEST_ROLE_ID>
SEMESTER_ALLOWED_ROLE_IDS=
# Custom status shown under the bot's name (default: Γράψε /auth για επιβεβαίωση)
BOT_STATUS=

# ---------- Email codes ----------
# Keyed hash for university identifiers and codes. At least 32 characters. Changing it breaks the
# "one university account per Discord account" check for existing members.
UNI_ID_HASH_SECRET=replace-with-a-long-random-secret-at-least-32-chars
# "smtp" for real use. "console" prints the codes to the bot log instead of emailing them (testing only).
EMAIL_TRANSPORT=smtp
EMAIL_FROM="Πληροφορική UoWM Discord <your-sender@gmail.com>"
# Example for Gmail with an app password: smtp.gmail.com, 587, false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-sender@gmail.com
SMTP_PASS=
# Institutional mail domain, and the student username pattern (first group = student number).
# Keep regex values in single quotes.
EMAIL_DOMAIN=uowm.gr
EMAIL_STUDENT_PATTERN='^cs(\d{4,6})$'
# Faculty addresses are read from data/faculty-emails.txt (see data/faculty-emails.example.txt)

# ---------- MariaDB ----------
DB_USER=uowm_bot
DB_PASSWORD=replace-with-a-strong-password
DB_NAME=uowm_bot
